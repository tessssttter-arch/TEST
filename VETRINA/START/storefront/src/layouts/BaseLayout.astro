---
interface Props {
  title: string;
  description?: string;
  image?: string;
  url?: string;
  jsonLd?: object;
}
const { title, description, image, url, jsonLd } = Astro.props;
---
<!DOCTYPE html>
<html lang="ru" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght=400;500;600;700&family=JetBrains+Mono:wght=400;500&display=swap" rel="stylesheet">
    
    <title>{title} | Vintage Store</title>
    <meta name="description" content={description || 'Архивная винтажная одежда с доставкой.'} />
    <link rel="canonical" href={url || Astro.url.href} />
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description || 'Vintage Store'} />
    <meta property="og:image" content={image || '/og-default.jpg'} />
    <meta property="og:url" content={url || Astro.url.href} />
    <meta property="og:type" content="product" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="bg-stone-50 text-stone-900 font-sans antialiased min-h-screen flex flex-col">
    <header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-stone-200">
      <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
        <a href="/" class="font-mono font-bold text-lg tracking-tight">VINTAGE<span class="text-emerald-600">.ARCHIVE</span></a>
        <span class="text-[10px] font-mono text-stone-400 uppercase tracking-widest">Curated Selection</span>
      </div>
    </header>
    <main class="flex-1"><slot /></main>
    <footer class="bg-stone-100 border-t border-stone-200 py-8 mt-12">
      <div class="max-w-7xl mx-auto px-4 text-center text-[10px] font-mono text-stone-400">
        © {new Date().getFullYear()} Vintage Archive. Powered by Astro & Curator Platform.
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import "tailwindcss";
  @theme {
    --font-sans: "Inter", ui-sans-serif, system-ui, sans-serif;
    --font-mono: "JetBrains Mono", ui-monospace, monospace;
  }
</style>
